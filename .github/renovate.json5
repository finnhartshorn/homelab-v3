{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    ':automergeBranch',
    ':dependencyDashboard',
    ':disableRateLimiting',
    ':semanticCommits',
    ':separatePatchReleases',
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  schedule: [
    'every weekend',
  ],
  ignorePaths: [
    '**/*.sops.*',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  packageRules: [
    {
      description: [
        'Auto-merge GitHub Actions for minor and patch',
      ],
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      description: [
        'Auto merge selected packages',
      ],
      matchPackageNames: [
        'ghcr.io/home-operations/prowlarr',
        'ghcr.io/home-operations/sonarr',
        'ghcr.io/home-operations/radarr',
        'ghcr.io/flaresolverr/flaresolverr',
        'windmill',
        'docker.io/cloudflare/cloudflared',
        'code.forgejo.org/forgejo-helm/forgejo',
        'app**template',
        'home-assistant',
        'home-assistant-matter-server',
        'grafana',
        'uv',
        'astral-sh/uv',
        'mikefarah/yq',
        'fluxcd/flux2',
        'budimanjojo/talhelper',
        'go-task/task',
        'yannh/kubeconform',
        'getsops/sops',
        'python',
        'python/cpython',
        'ingress-nginx',
        'csi-driver-smb',
        'adguard/adguardhome',
        'FiloSottile/age',
        'cloudflare/cloudflared',
        'metrics-server',
        '/reloader/',
        'docker.io/library/telegraf',
        '/flux-operator/',
        '/flux-instance/',
        'external-dns',
        '/spegel/',
        'code.forgejo.org/forgejo/runner',
        'docker.io/docker',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      description: [
        'Block docker.io/docker 29.7.0: CopyToContainer regression breaks',
        'forgejo-runner checkout ("path escapes from parent" on the',
        '/var/run -> /run symlink). See moby/moby#53258. Remove once a',
        'released patch (29.7.1+) is confirmed to include the fix.',
      ],
      matchPackageNames: [
        'docker.io/docker',
      ],
      allowedVersions: '!/^29\\.7\\.0/',
    },
    {
      description: [
        'Auto merge helm/helmfile CLI tooling, including majors',
      ],
      matchPackageNames: [
        'helm/helm',
        'helmfile/helmfile',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      description: [
        'Auto merge patch-only for sensitive infrastructure',
      ],
      matchPackageNames: [
        'cert-manager',
        'cilium',
        'coredns',
        'ghcr.io/coredns/charts/coredns',
        'ghcr.io/home-operations/charts/tuppr',
      ],
      matchUpdateTypes: [
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      description: [
        'git.finnethen.com is only reachable from the home network, so',
        'Mend-hosted Renovate can never reach its registry API - disable',
        'lookups to avoid timeouts/no-result warnings on every run',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'git.finnethen.com/**',
      ],
      enabled: false,
    },
    {
      description: [
        'Flux Operator Group',
      ],
      groupName: 'Flux Operator',
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      matchPackageNames: [
        '/flux-operator/',
        '/flux-instance/',
      ],
    },
    {
      description: [
        'CoreDNS Group - the flux HelmRelease (depName "coredns") and the',
        'bootstrap helmfile release (inline oci chart, depName',
        '"ghcr.io/coredns/charts/coredns") are the same chart tracked under',
        'two different depNames, producing duplicate PRs for every release -',
        'group them into one. Both already report bare (non-"v"-prefixed)',
        'versions, so no extractVersion strip is needed here unlike the',
        'Kubernetes/Talos groups below',
      ],
      groupName: 'CoreDNS',
      matchDatasources: [
        'docker',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      matchPackageNames: [
        'coredns',
        'ghcr.io/coredns/charts/coredns',
      ],
    },
    {
      description: [
        'Talos Group - covers both the docker-sourced installer/talosctl',
        'images and the aqua-sourced talosctl CLI pinned in .mise.toml, so',
        'a Talos release produces a single combined PR instead of one per',
        'datasource',
      ],
      groupName: 'Talos',
      matchDatasources: [
        'docker',
        'github-releases',
        'github-tags',
      ],
      group: {
        commitMessageTopic: '{{{groupName}}} group',
      },
      matchPackageNames: [
        '/siderolabs/talosctl/',
        '/siderolabs/installer/',
        'siderolabs/talos',
      ],
    },
    {
      description: [
        'installer/talosctl docker tags carry a "v" prefix that the aqua-',
        'sourced siderolabs/talos package does not, so their version strings',
        'never match even at the same release - strip it so the grouped Talos',
        'PR title can render currentVersion -> newVersion once all three',
        'catch up to a shared version, same treatment as the Kubernetes group',
        'below',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/siderolabs/talosctl/',
        '/siderolabs/installer/',
      ],
      extractVersion: '^v(?<version>.*)$',
    },
    {
      description: [
        'Propose one PR per minor release stream for the Talos installer,',
        'instead of jumping straight to latest - this must be upgraded one',
        'minor version at a time',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/siderolabs/installer',
      ],
      separateMultipleMinor: true,
    },
    {
      description: [
        'Keep the kubelet image and the alpine/k8s kubectl tooling image (used',
        'by tuppr-watchdog/tuppr-log-capture) in sync, and propose one PR per',
        'minor release stream instead of jumping straight to latest -',
        'Kubernetes must be upgraded one minor version at a time, so give',
        'tuppr/us a PR per intermediate step',
      ],
      groupName: 'Kubernetes',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'docker.io/alpine/k8s',
      ],
      separateMultipleMinor: true,
    },
    {
      description: [
        'kubelet tags carry a "v" prefix that alpine/k8s tags do not, so their',
        'version strings never match even at the same release - strip it so',
        'the grouped Kubernetes PR title can render currentVersion -> newVersion',
        'again once the two catch up to a shared version.',
        'Kept global (not scoped to talconfig.yaml) so every occurrence of this',
        'depName resolves to the same version identity and the grouped title',
        'stays uniform - see the dedicated kubernetesupgrade.yaml manager below',
        'for how the "v" prefix survives there despite this strip.',
      ],
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
      ],
      extractVersion: '^v(?<version>.*)$',
    },
    {
      description: [
        'Propose one PR per minor release stream for Longhorn, instead of',
        'jumping straight to latest',
      ],
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'longhorn',
      ],
      separateMultipleMinor: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(container)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: ' ( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'container',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'container',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'container',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentDigestShort}} → {{newDigestShort}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(helm)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'helm',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'helm',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(github-release)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'github-release',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'github-release',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: 'feat(github-action)!: ',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      semanticCommitScope: 'github-action',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'github-action',
      commitMessageTopic: '{{depName}}',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'type/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'type/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'type/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/container',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      addLabels: [
        'renovate/helm',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
        'github-tags',
      ],
      addLabels: [
        'renovate/github-release',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-action',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: [
        'Process YAML custom dependencies',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
    {
      customType: 'regex',
      description: [
        'tuppr KubernetesUpgrade CRD requires the kubelet image tag with its',
        'native "v" prefix, which the global ghcr.io/siderolabs/kubelet',
        'extractVersion strip (kept for the grouped Kubernetes PR title, see',
        'packageRules above) would otherwise remove. Match this field with',
        'its own manager instead of the generic depName-comment one, with the',
        '"v" as a literal outside the captured group, so it survives in the',
        'file untouched no matter what stripped digits get written in.',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/apps/system-upgrade/tuppr/config/kubernetesupgrade\\.ya?ml$/',
      ],
      matchStrings: [
        'version:\\s*v(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'ghcr.io/siderolabs/kubelet',
    },
    {
      customType: 'regex',
      description: [
        'talhelper requires the Talos installer version with its native "v"',
        'prefix, which the global ghcr.io/siderolabs/installer extractVersion',
        'strip (kept for the grouped Talos PR title, see packageRules above)',
        'would otherwise remove. Match this field with its own manager instead',
        'of the generic depName-comment one, with the "v" as a literal outside',
        'the captured group, so it survives in the file untouched no matter',
        'what stripped digits get written in.',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/bootstrap/talos/talconfig\\.ya?ml$/',
      ],
      matchStrings: [
        'talosVersion:\\s*v(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'ghcr.io/siderolabs/installer',
    },
    {
      customType: 'regex',
      description: [
        'tuppr TalosUpgrade CRD requires the installer image tag with its',
        'native "v" prefix - same treatment as talconfig.yaml above and the',
        'KubernetesUpgrade CRD manager above.',
      ],
      managerFilePatterns: [
        '/(^|/)kubernetes/apps/system-upgrade/tuppr/config/talosupgrade\\.ya?ml$/',
      ],
      matchStrings: [
        'version:\\s*v(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'ghcr.io/siderolabs/installer',
    },
  ],
}
